# Telegram (get api_id / api_hash at https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=discovery
TELEGRAM_GROUP=            # group username or numeric id
TELEGRAM_MESSAGE_LIMIT=1000

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.1:8b

# Cloud fallback (Claude Sonnet) - leave key empty to disable Stage 4
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Pipeline thresholds
EMBED_THRESHOLD=0.75
CONFIDENCE_FALLBACK_BELOW=0.6
MIN_WORDS=4
